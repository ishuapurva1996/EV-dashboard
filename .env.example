# Copy this file to .env and fill in the personal fields below.
# Use your current working Snowflake account and a database with separate EV schemas.

# ─── Current Snowflake account ───────────────────────────
SNOWFLAKE_ACCOUNT=your-current-account
SNOWFLAKE_DATABASE=your-current-database
SNOWFLAKE_SCHEMA=ANALYTICS_EV
SNOWFLAKE_ROLE=your-existing-role

# ─── Private login and existing warehouse ─────────────────
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=

# ─── Other ─────────────────────────────────────────────────
# DBT_PROFILES_DIR points at the project-local profiles.yml inside the Airflow container.
# Leave as-is unless you change the compose mount.
DBT_PROFILES_DIR=/opt/airflow/dbt

# API keys for ingestion DAGs (each teammate registers their own — both are free + instant)
NREL_API_KEY=
CENSUS_API_KEY=

# Airflow user id inside the container (50000 is the default — leave as-is)
AIRFLOW_UID=50000

# Separate port from the weather project.
EV_AIRFLOW_PORT=8083
# Private local service login; init and metadata reader must use the same values.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=
# Alternatively supply snowflake_default as a private connection JSON.
AIRFLOW_CONN_SNOWFLAKE_DEFAULT=
# Success-only dashboard handoff. Existing AWS profile mounted read-only.
AWS_CREDENTIALS_DIR=/absolute/path/to/.aws
DASHBOARD_S3_BUCKET=
DASHBOARD_S3_PREFIX=dashboard/ev
AWS_DEFAULT_REGION=us-west-1
# Optional alternatives to the mounted AWS profile:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DASHBOARD_AIRFLOW_API_URL=http://localhost:8080
DASHBOARD_AIRFLOW_USERNAME=
DASHBOARD_AIRFLOW_PASSWORD=
# Fine-grained token scoped to EV-dashboard with Actions: read/write.
DASHBOARD_GITHUB_TOKEN=
